        RowBox[{"Im", "[", "u", "]"}], ",", 
        RowBox[{"Re", "[", "u", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", 
        RowBox[{"urMin", "+", 
         RowBox[{"I", "*", "Rmin"}]}], ",", 
        RowBox[{"urMax", "+", 
         RowBox[{"I", "*", "Rmax"}]}]}], "}"}], ",", 
      RowBox[{"ColorFunction", "->", "\"\<CyclicReImLogAbs\>\""}], ",", 
      RowBox[{"PlotPoints", "->", "120"}], ",", 
      RowBox[{"MaxRecursion", "->", "3"}], ",", 
      RowBox[{"ImageSize", "->", "Large"}], ",", 
      RowBox[{"FrameLabel", "->", 
