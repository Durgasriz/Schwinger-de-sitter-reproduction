Cell["\<\
The instanton must become real at both ends, so that it describes real \
asymptotic particles. At the saddle-point momenta this requires (Eq. 20)
   Im t = Im x = Im \:1e6b = Im \:1e8b = 0.

On the imaginary axis, t(u) becomes real at u = iRc. Since Eq. (22) has real \
coefficients, t, x, \:1e6b, \:1e8b then stay real along the whole horizontal \
line Im u = Rc, including the corner u = \[Minus]Rc + iRc.

Contour (green line): horizontal for Re u < \[Minus]Rc, diagonal from \
\[Minus]Rc + iRc to Rc \[Minus] iRc, then horizontal again. Beyond the \
corners the solution stays real, so the integration can stop there.

Checks:
  (i) integrating straight along the diagonal to the corner gives vanishing \
imaginary parts (Eq. 20);
  (ii) the diagonal route and the grid route give the same values at the \
corner, so no singularity lies between them and the contour is unambiguous.
Small residuals (~10\:207b\:2074) come from p = 0.57 being only approximately \
p_s, and from the linear interpolation.\
\>", "Text",
 CellChangeTimes->{
  4.0031922047743607`*^9},ExpressionUUID->"a289603c-8ebc-8447-9e57-\
cc30d054378a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["green contour selection", "Subsection",
 CellChangeTimes->{{3.989326395305319*^9, 
  3.989326402961521*^9}},ExpressionUUID->"da86927d-2058-684d-858b-\
dec185fe9cae"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cp", "=", 
    RowBox[{"ComplexPlot", "[", 
     RowBox[{
      RowBox[{"tInterp2", "[", 
       RowBox[{
        RowBox[{"Im", "[", "u", "]"}], ",", 
        RowBox[{"Re", "[", "u", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", 
        RowBox[{"urMin", "+", 
         RowBox[{"I", "*", "Rmin"}]}], ",", 
        RowBox[{"urMax", "+", 
         RowBox[{"I", "*", "Rmax"}]}]}], "}"}], ",", 
      RowBox[{"ColorFunction", "->", "\"\<CyclicReImLogAbs\>\""}], ",", 
      RowBox[{"PlotPoints", "->", "120"}], ",", 
      RowBox[{"MaxRecursion", "->", "3"}], ",", 
      RowBox[{"Frame", "->", "False"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"contours", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"ContourPlot", "[", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"tInterp2", "[", 
          RowBox[{"R", ",", "ur"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ur", ",", "urMin", ",", "urMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"R", ",", "Rmin", ",", "Rmax"}], "}"}], ",", 
        RowBox[{"Contours", "->", 
         RowBox[{"{", "0", "}"}]}], ",", 
        RowBox[{"ContourShading", "->", "None"}], ",", 
        RowBox[{"ContourStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Red", ",", "Thick"}], "}"}]}], ",", 
        RowBox[{"Frame", "->", "False"}]}], "]"}], ",", 
      RowBox[{"ContourPlot", "[", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"xInterp2", "[", 
          RowBox[{"R", ",", "ur"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ur", ",", "urMin", ",", "urMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"R", ",", "Rmin", ",", "Rmax"}], "}"}], ",", 
        RowBox[{"Contours", "->", 
         RowBox[{"{", "0", "}"}]}], ",", 
        RowBox[{"ContourShading", "->", "None"}], ",", 
        RowBox[{"ContourStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Blue", ",", "Thick"}], "}"}]}], ",", 
        RowBox[{"Frame", "->", "False"}]}], "]"}], ",", 
      RowBox[{"ContourPlot", "[", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"tdotInterp2", "[", 
          RowBox[{"R", ",", "ur"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ur", ",", "urMin", ",", "urMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"R", ",", "Rmin", ",", "Rmax"}], "}"}], ",", 
        RowBox[{"Contours", "->", 
         RowBox[{"{", "0", "}"}]}], ",", 
        RowBox[{"ContourShading", "->", "None"}], ",", 
        RowBox[{"ContourStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Green", ",", "Thick"}], "}"}]}], ",", 
        RowBox[{"Frame", "->", "False"}]}], "]"}], ",", 
      RowBox[{"ContourPlot", "[", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"xdotInterp2", "[", 
          RowBox[{"R", ",", "ur"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ur", ",", "urMin", ",", "urMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"R", ",", "Rmin", ",", "Rmax"}], "}"}], ",", 
        RowBox[{"Contours", "->", 
         RowBox[{"{", "0", "}"}]}], ",", 
        RowBox[{"ContourShading", "->", "None"}], ",", 
        RowBox[{"ContourStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Purple", ",", "Thick"}], "}"}]}], ",", 
        RowBox[{"Frame", "->", "False"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"cp", ",", "contours", ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.989322256090048*^9, 3.989322262079981*^9}, {
   3.989322432444811*^9, 3.989322438848358*^9}, {3.989322477841358*^9, 
