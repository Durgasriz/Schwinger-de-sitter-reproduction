Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"horizontalData", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t0", ",", "dt0", ",", "x0", ",", "dx0", ",", "sol"}], "}"}],
         ",", 
        RowBox[{
         RowBox[{"t0", "=", 
          RowBox[{"Tfun", "[", "R0", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"dt0", "=", 
          RowBox[{
           RowBox[{"-", "I"}], "*", 
           RowBox[{"dTfun", "[", "R0", "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"x0", "=", 
          RowBox[{"Xfun", "[", "R0", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"dx0", "=", 
          RowBox[{
           RowBox[{"-", "I"}], "*", 
           RowBox[{"dXfun", "[", "R0", "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"t", "''"}], "[", "ur", "]"}], "==", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"t", "'"}], "[", "ur", "]"}], "^", "2"}]}], ")"}],
                 " ", 
                RowBox[{"At", "[", 
                 RowBox[{"t", "[", "ur", "]"}], "]"}]}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "''"}], "[", "ur", "]"}], "==", 
               RowBox[{
                RowBox[{"-", "2"}], " ", 
                RowBox[{
                 RowBox[{"t", "'"}], "[", "ur", "]"}], " ", 
                RowBox[{
                 RowBox[{"x", "'"}], "[", "ur", "]"}], " ", 
                RowBox[{"At", "[", 
                 RowBox[{"t", "[", "ur", "]"}], "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"t", "[", "0", "]"}], "==", "t0"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"t", "'"}], "[", "0", "]"}], "==", "dt0"}], ",", 
              RowBox[{
               RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "'"}], "[", "0", "]"}], "==", "dx0"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "x"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ur", ",", "urMin", ",", "urMax"}], "}"}], ",", 
            RowBox[{"WorkingPrecision", "->", "40"}], ",", 
            RowBox[{"AccuracyGoal", "->", "20"}], ",", 
            RowBox[{"PrecisionGoal", "->", "20"}], ",", 
            RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ur", ",", "R0", ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{
               RowBox[{"t", "[", "ur", "]"}], "/.", " ", 
               RowBox[{"sol", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{
               RowBox[{"x", "[", "ur", "]"}], "/.", " ", 
               RowBox[{"sol", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t", "'"}], "[", "ur", "]"}], "/.", " ", 
               RowBox[{"sol", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "'"}], "[", "ur", "]"}], "/.", " ", 
               RowBox[{"sol", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ur", ",", "urGrid"}], "}"}]}], "]"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"R0", ",", "RGrid"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"flatData", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"horizontalData", ",", "1"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tGrid", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{"flatData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", 
     RowBox[{"Length", "[", "urGrid", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"tdotGrid", " ", "=", " ", 
  RowBox[{"Partition", "[", 
   RowBox[{
    RowBox[{"flatData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", 
    RowBox[{"Length", "[", "urGrid", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xGrid2", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{"flatData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "4"}], "]"}], "]"}], ",", 
     RowBox[{"Length", "[", "urGrid", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"xdotGrid", " ", "=", " ", 
  RowBox[{"Partition", "[", 
   RowBox[{
